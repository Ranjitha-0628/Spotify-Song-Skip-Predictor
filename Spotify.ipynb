    "# Set up the plotting style\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "fig, axes = plt.subplots(2, 3, figsize=(18, 10))\n",
    "fig.suptitle('Spotify Skip Behavior Analysis', fontsize=16, fontweight='bold')\n",
    "\n",
    "# 1. Skip rate by genre\n",
    "skip_by_genre = df.groupby('genre')['skipped'].mean().sort_values(ascending=False)\n",
