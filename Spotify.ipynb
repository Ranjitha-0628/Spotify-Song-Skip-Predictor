   "source": [
    "def generate_spotify_data(n_sessions=500):\n",
    "    \"\"\"\n",
    "    Generate synthetic Spotify listening data\n",
    "    \"\"\"\n",
    "    \n",
    "    genres = ['pop', 'rock', 'hip-hop', 'electronic', 'indie', 'jazz', 'classical']\n",
    "    times_of_day = ['morning', 'midday', 'evening', 'night']\n",
    "    \n",
    "    data = []\n",
    "    \n",
    "    for session_id in range(n_sessions):\n",
    "        # Each session has 8-15 songs\n",
    "        n_songs = np.random.randint(8, 16)\n",
    "        \n",
    "        # Session context\n",
    "        time_of_day = np.random.choice(times_of_day)\n",
    "        \n",
    "        prev_genre = None\n",
    "        \n",
    "        for position in range(1, n_songs + 1):\n",
    "            # Song features\n",
    "            genre = np.random.choice(genres)\n",
    "            tempo = np.random.normal(120, 25)  # BPM\n",
    "            energy = np.random.beta(2, 2)  # 0-1 scale\n",
    "            danceability = np.random.beta(2, 2)\n",
    "            valence = np.random.beta(2, 2)  # happiness\n",
    "            loudness = np.random.normal(-7, 3)  # dB\n",
    "            duration = np.random.normal(210, 45)  # seconds\n",
    "            \n",
    "            # Context features\n",
    "            genre_switch = 1 if prev_genre and prev_genre != genre else 0\n",
    "            \n",
    "            # Skip logic (this is where we encode realistic behavior)\n",
    "            skip_prob = 0.3  # base skip rate\n",
    "            \n",
    "            # Factors that increase skip probability\n",
    "            if position > 10:  # fatigue later in session\n",
    "                skip_prob += 0.15\n",
    "            if genre_switch:  # jarring genre changes\n",
    "                skip_prob += 0.2\n",
    "            if time_of_day == 'morning' and energy < 0.4:  # low energy in morning\n",
    "                skip_prob += 0.25\n",
    "            if time_of_day == 'night' and energy > 0.8:  # too energetic at night\n",
    "                skip_prob += 0.2\n",
    "            if tempo < 80 or tempo > 160:  # extreme tempos\n",
    "                skip_prob += 0.15\n",
    "            if abs(valence - 0.5) < 0.1:  # neutral/boring mood\n",
    "                skip_prob += 0.1\n",
    "            if duration > 300:  # very long songs\n",
    "                skip_prob += 0.15\n",
    "                \n",
    "            # Cap probability\n",
    "            skip_prob = min(skip_prob, 0.85)\n",
    "            \n",
    "            # Determine if skipped\n",
    "            skipped = 1 if np.random.random() < skip_prob else 0\n",
    "            \n",
    "            # If skipped, when?\n",
    "            if skipped:\n",
    "                # Most skips happen early (exponential distribution)\n",
    "                skip_time = min(int(np.random.exponential(20)), duration)\n",
    "            else:\n",
    "                skip_time = None\n",
    "            \n",
    "            data.append({\n",
    "                'session_id': session_id,\n",
    "                'position_in_session': position,\n",
    "                'genre': genre,\n",
    "                'tempo': tempo,\n",
    "                'energy': energy,\n",
    "                'danceability': danceability,\n",
    "                'valence': valence,\n",
    "                'loudness': loudness,\n",
    "                'duration_sec': duration,\n",
    "                'time_of_day': time_of_day,\n",
    "                'genre_switch': genre_switch,\n",
    "                'skipped': skipped,\n",
    "                'skip_time_sec': skip_time\n",
    "            })\n",
    "            \n",
    "            prev_genre = genre\n",
    "    \n",
    "    return pd.DataFrame(data)\n",
    "\n",
    "# Generate the dataset\n",
    "print(\"Generating listening data...\")\n",
    "df = generate_spotify_data(n_sessions=500)\n",
    "print(f\"✓ Generated {len(df)} song plays across {df['session_id'].nunique()} sessions\")\n",
    "print(f\"\\nSkip rate: {df['skipped'].mean()*100:.1f}%\")\n",
    "df.head(10)"
   ]
  },
